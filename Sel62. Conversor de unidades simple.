import java.util.Scanner;

public class ConversorDeUnidades {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int opcion;
        double valor, resultado;

        System.out.println("CONVERSOR DE UNIDADES");
        System.out.println("1. Kilómetros a metros");
        System.out.println("2. Metros a centímetros");
        System.out.println("3. Horas a minutos");
        System.out.println("4. Salir");

        System.out.print("Seleccione una opción: ");
        opcion = entrada.nextInt();

        switch (opcion) {
            case 1:
                System.out.print("Ingrese los kilómetros: ");
                valor = entrada.nextDouble();
                resultado = valor * 1000;
                System.out.println("Metros: " + resultado);
                break;
            case 2:
                System.out.print("Ingrese los metros: ");
                valor = entrada.nextDouble();
                resultado = valor * 100;
                System.out.println("Centímetros: " + resultado);
                break;
            case 3:
                System.out.print("Ingrese las horas: ");
                valor = entrada.nextDouble();
                resultado = valor * 60;
                System.out.println("Minutos: " + resultado);
                break;
            case 4:
                System.out.println("Saliendo del conversor");
                break;
            default:
                System.out.println("Opción inválida");
        }

        entrada.close();
    }
}
