import java.util.Scanner;

public class SimulacionDeAhorroConAportesVariables {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N;
        double aporte, saldo = 0;

        System.out.print("Ingrese el número de meses: ");
        N = sc.nextInt();

        for (int i = 1; i <= N; i++) {
            System.out.print("Ingrese el aporte del mes: ");
            aporte = sc.nextDouble();

            saldo = (saldo + aporte) * 1.008;
        }

        System.out.println("Saldo final: " + saldo);
    }
}
