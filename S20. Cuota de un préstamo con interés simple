import java.util.Scanner;

public class CuotaDeUnPrestamoConInteresSimple {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double capital, tasa, interes, cuota;
        int meses;

        System.out.print("Ingrese el capital: ");
        capital = sc.nextDouble();

        System.out.print("Ingrese la tasa anual: ");
        tasa = sc.nextDouble();

        System.out.print("Ingrese el número de meses: ");
        meses = sc.nextInt();

        interes = capital * tasa * (meses / 12.0);
        cuota = (capital + interes) / meses;

        System.out.println("Interés total: " + interes);
        System.out.println("Cuota mensual: " + cuota);
    }
}
