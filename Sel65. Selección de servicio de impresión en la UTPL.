import java.util.Scanner;

public class SeleccionDeServicioDeImpresion {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int opcion, paginas;
        double total;

        System.out.println("SERVICIO DE IMPRESIÓN");
        System.out.println("1. Blanco y negro - $0.05");
        System.out.println("2. A color - $0.15");
        System.out.println("3. Fotocopia - $0.03");
        System.out.println("4. Salir");

        System.out.print("Seleccione una opción: ");
        opcion = entrada.nextInt();

        switch (opcion) {
            case 1:
                System.out.print("Ingrese la cantidad de páginas: ");
                paginas = entrada.nextInt();
                total = paginas * 0.05;
                System.out.println("Total a pagar: $" + total);
                break;
            case 2:
                System.out.print("Ingrese la cantidad de páginas: ");
                paginas = entrada.nextInt();
                total = paginas * 0.15;
                System.out.println("Total a pagar: $" + total);
                break;
            case 3:
                System.out.print("Ingrese la cantidad de páginas: ");
                paginas = entrada.nextInt();
                total = paginas * 0.03;
                System.out.println("Total a pagar: $" + total);
                break;
            case 4:
                System.out.println("Gracias por utilizar el servicio");
                break;
            default:
                System.out.println("Opción inválida");
        }

        entrada.close();
    }
}
