import java.util.Scanner;

public class ProductoSumaYMediaAritmetica {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double a, b, c, d;
        double producto, suma, media;

        System.out.print("Ingrese el primer dato: ");
        a = sc.nextDouble();

        System.out.print("Ingrese el segundo dato: ");
        b = sc.nextDouble();

        System.out.print("Ingrese el tercer dato: ");
        c = sc.nextDouble();

        System.out.print("Ingrese el cuarto dato: ");
        d = sc.nextDouble();

        producto = a * b * c * d;
        suma = a + b + c + d;
        media = suma / 4;

        System.out.println("Producto: " + producto);
        System.out.println("Suma: " + suma);
        System.out.println("Media aritmética: " + media);
    }
}
