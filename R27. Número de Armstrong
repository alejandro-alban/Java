import java.util.Scanner;

public class NumeroDeArmstrong {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int numero, original, digito, suma = 0;

        System.out.print("Ingrese un número de tres dígitos: ");
        numero = sc.nextInt();

        original = numero;

        while (numero > 0) {
            digito = numero % 10;
            suma = suma + (int)Math.pow(digito, 3);
            numero = numero / 10;
        }

        if (suma == original) {
            System.out.println("Es un número Armstrong");
        } else {
            System.out.println("No es un número Armstrong");
        }
    }
}
