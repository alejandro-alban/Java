import java.util.Scanner;

public class SumaDeLaSerieArmonica {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N;
        double suma = 0;

        System.out.print("Ingrese N: ");
        N = sc.nextInt();

        for (int i = 1; i <= N; i++) {
            suma = suma + (1.0 / i);
        }

        System.out.println("Suma de la serie: " + suma);
    }
}
