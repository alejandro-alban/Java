import java.util.Scanner;

public class PrestamoConInteresCompuesto {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        double monto, tasa, porcentaje, total, abono, finalPagar;
        int trimestres;

        System.out.print("Ingrese el monto del préstamo: ");
        monto = entrada.nextDouble();

        System.out.print("Ingrese la tasa trimestral en decimal: ");
        tasa = entrada.nextDouble();

        System.out.print("Ingrese el número de trimestres: ");
        trimestres = entrada.nextInt();

        System.out.print("Ingrese el porcentaje de abono extraordinario: ");
        porcentaje = entrada.nextDouble();

        total = monto * Math.pow(1 + tasa, trimestres);
        abono = total * (porcentaje / 100);
        finalPagar = total - abono;

        System.out.println("Monto antes del abono: " + total);
        System.out.println("Valor del abono: " + abono);
        System.out.println("Monto final a pagar: " + finalPagar);

        entrada.close();
    }
}
