import java.util.Scanner;

public class DescuentoEnLibreria {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        String estudiante;
        double compra, descuento = 0, total;

        System.out.print("¿Es estudiante UTPL? (S/N): ");
        estudiante = entrada.next().toUpperCase();

        System.out.print("Ingrese el monto de compra: ");
        compra = entrada.nextDouble();

        if (estudiante.equals("S")) {
            descuento = 20;
            if (compra > 30) {
                descuento += 5;
            }
        } else {
            if (compra > 50) {
                descuento = 10;
            }
        }

        total = compra - (compra * descuento / 100);

        System.out.println("Descuento aplicado: " + descuento + "%");
        System.out.println("Monto final a pagar: " + total);

        entrada.close();
    }
}
