import java.util.Scanner;

public class Tabla_Multiplicar {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int k, resultado;

        System.out.print("Ingrese un numero entero: ");
        k = sc.nextInt();

        for (int i = 1; i <= 10; i++) {
            resultado = k * i;
            System.out.println(k + " x " + i + " = " + resultado);
        }

        sc.close();
    }
}
