import java.util.Scanner;

public class Gasto_Semanal_Transporte {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int viajes, dias;
        double costo, gasto;

        System.out.print("Ingrese los viajes por dia: ");
        viajes = sc.nextInt();

        System.out.print("Ingrese el costo del pasaje: ");
        costo = sc.nextDouble();

        System.out.print("Ingrese los dias por semana: ");
        dias = sc.nextInt();

        gasto = viajes * costo * dias;

        System.out.println("El gasto semanal es: $" + gasto);

        sc.close();
    }
}
