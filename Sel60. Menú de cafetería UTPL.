import java.util.Scanner;

public class MenuDeCafeteria {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int opcion;

        System.out.println("MENÚ DE CAFETERÍA");
        System.out.println("1. Café - $1.50");
        System.out.println("2. Jugo - $1.20");
        System.out.println("3. Sandwich - $2.50");
        System.out.println("4. Salir");

        System.out.print("Seleccione una opción: ");
        opcion = entrada.nextInt();

        switch (opcion) {
            case 1:
                System.out.println("Café: $1.50");
                break;
            case 2:
                System.out.println("Jugo: $1.20");
                break;
            case 3:
                System.out.println("Sandwich: $2.50");
                break;
            case 4:
                System.out.println("Gracias por visitarnos");
                break;
            default:
                System.out.println("Opción inválida");
        }

        entrada.close();
    }
}
