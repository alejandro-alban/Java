import java.util.Scanner;

public class ClasificacionDeNotasPorLetra {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        String letra;

        System.out.print("Ingrese la letra de calificación (A, B, C, D, F): ");
        letra = entrada.next().toUpperCase();

        switch (letra) {
            case "A":
                System.out.println("Rango de nota: 9 - 10");
                break;
            case "B":
                System.out.println("Rango de nota: 8 - 8.9");
                break;
            case "C":
                System.out.println("Rango de nota: 7 - 7.9");
                break;
            case "D":
                System.out.println("Rango de nota: 6 - 6.9");
                break;
            case "F":
                System.out.println("Rango de nota: 0 - 5.9");
                break;
            default:
                System.out.println("Letra no válida");
        }

        entrada.close();
    }
}
