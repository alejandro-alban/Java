import java.util.Scanner;

public class ClasificacionDeTrianguloPorAngulos {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double a, b, c;

        System.out.print("Ingrese el primer ángulo: ");
        a = sc.nextDouble();

        System.out.print("Ingrese el segundo ángulo: ");
        b = sc.nextDouble();

        System.out.print("Ingrese el tercer ángulo: ");
        c = sc.nextDouble();

        if (a > 0 && b > 0 && c > 0 && a + b + c == 180) {
            if (a == 90 || b == 90 || c == 90) {
                System.out.println("Triángulo rectángulo");
            } else if (a > 90 || b > 90 || c > 90) {
                System.out.println("Triángulo obtusángulo");
            } else {
                System.out.println("Triángulo acutángulo");
            }
        } else {
            System.out.println("Los ángulos no forman un triángulo");
        }
    }
}
