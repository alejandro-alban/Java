import java.util.Scanner;

public class AmortizacionDePrestamoSimple {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double monto, tasa, interes, cuota;
        int meses;

        System.out.print("Ingrese el monto del préstamo: ");
        monto = sc.nextDouble();

        System.out.print("Ingrese la tasa mensual (%): ");
        tasa = sc.nextDouble();

        System.out.print("Ingrese el número de meses: ");
        meses = sc.nextInt();

        interes = monto * (tasa / 100) * meses;
        cuota = (monto + interes) / meses;

        System.out.println("Interés total: " + interes);
        System.out.println("Cuota mensual: " + cuota);
    }
}
