import java.util.Scanner;

public class AhorroConInteresCompuestoMensual {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double capital, deposito, tasa;
        int n;

        System.out.print("Ingrese el capital inicial: ");
        capital = sc.nextDouble();

        System.out.print("Ingrese el depósito mensual: ");
        deposito = sc.nextDouble();

        System.out.print("Ingrese el número de meses: ");
        n = sc.nextInt();

        System.out.print("Ingrese la tasa mensual (%): ");
        tasa = sc.nextDouble();

        for (int mes = 1; mes <= n; mes++) {
            capital = (capital + deposito) * (1 + tasa / 100);
            System.out.println("Mes " + mes + " - Saldo: " + capital);
        }
    }
}
